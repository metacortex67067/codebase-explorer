# ============================================================================
# LLM provider. Pick ONE block below. Default (recommended) = Groq: free cloud
# tier, very fast, no local install. Just get a key and paste it.
# ============================================================================

# ---- Option A: Groq (free cloud tier, very fast) — RECOMMENDED --------------
# Get a free key at https://console.groq.com/keys
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_paste_your_free_key_here
LLM_MODEL=llama-3.3-70b-versatile
# Alternative Groq models: qwen-2.5-coder-32b, deepseek-r1-distill-llama-70b

# ---- Option B: Ollama (free, runs locally, no account, fully offline) ------
# 1) Install Ollama:  https://ollama.com/download
# 2) Pull a model:    ollama pull qwen2.5-coder:7b
# 3) Ollama serves automatically on http://localhost:11434
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5-coder:7b

# ---- Option C: OpenRouter (free :free models) ------------------------------
# Get a free key at https://openrouter.ai/keys
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-your_key_here
# LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

# ---- Option D: Anthropic Claude (paid) -------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001

# Shared LLM knobs (defaults shown)
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.0

# ============================================================================
# Everything below is free and local already -- usually no need to touch.
# ============================================================================
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_TOP_K=5
